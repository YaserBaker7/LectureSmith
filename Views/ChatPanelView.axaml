<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LectureSmith.ViewModels"
             xmlns:m="using:LectureSmith.Models"
             x:Class="LectureSmith.Views.ChatPanelView"
             x:DataType="vm:ChatPanelViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource CardBackground}">
    <!-- Sub-Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBackgroundSecondary}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="💬" FontSize="13"/>
          <TextBlock Text="Follow-up Q&amp;A" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding Subtitle}"
                   FontSize="10.5"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <ProgressBar Grid.Column="2"
                     IsVisible="{Binding IsSending}"
                     IsIndeterminate="True"
                     Width="72" Height="4"
                     Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- Message List -->
    <ScrollViewer Grid.Row="1"
                  Name="ChatScroller"
                  Padding="16,12"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ChatMessage">
            <Grid Margin="0,6">
              <!-- User Message -->
              <Border IsVisible="{Binding IsUser}"
                      HorizontalAlignment="Right"
                      Background="{DynamicResource ChatUserBubbleBg}"
                      CornerRadius="14,14,2,14"
                      Padding="12,8"
                      MaxWidth="560">
                <SelectableTextBlock Text="{Binding Content}"
                                     Foreground="{DynamicResource ChatUserBubbleFg}"
                                     FontSize="12.5"
                                     TextWrapping="Wrap"/>
              </Border>

              <!-- AI Message -->
              <Border IsVisible="{Binding !IsUser}"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource ChatAiBubbleBg}"
                      BorderBrush="{DynamicResource ChatAiBubbleBorder}"
                      BorderThickness="1"
                      CornerRadius="14,14,14,2"
                      Padding="14,10"
                      MaxWidth="700">
                <StackPanel Spacing="6">
                  <TextBlock Text="🤖 LectureSmith Assistant"
                             FontSize="10.5"
                             FontWeight="Bold"
                             Foreground="{DynamicResource AccentSubtleText}"/>
                  <SelectableTextBlock Text="{Binding Content}"
                                       Foreground="{DynamicResource ChatAiBubbleFg}"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Input Bar -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBackgroundSecondary}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBox Grid.Column="0"
                 Text="{Binding InputText}"
                 Watermark="Ask a follow-up question... (Enter to send, Shift+Enter for newline)"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MaxHeight="90"
                 FontSize="12"
                 Padding="12,9"
                 KeyDown="ChatInput_KeyDown"
                 IsEnabled="{Binding !IsSending}"/>
        <Button Grid.Column="1"
                Classes="primary"
                Command="{Binding SendCommand}"
                IsEnabled="{Binding !IsSending}"
                Padding="18,9"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Send" FontWeight="SemiBold"/>
            <TextBlock Text="➤" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
