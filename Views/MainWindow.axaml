<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LectureSmith.ViewModels"
        xmlns:views="using:LectureSmith.Views"
        x:Class="LectureSmith.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="LectureSmith v4.0.0"
        Width="1280" Height="820"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Icon="avares://LectureSmith/Assets/app-icon.ico">

  <Grid ColumnDefinitions="244,*">

    <!-- ════════════════ FULL-HEIGHT LEFT SIDEBAR ════════════════ -->
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Brand Header -->
        <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="{DynamicResource CardBorderBrushSubtle}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11" ClipToBounds="True" VerticalAlignment="Center">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#7c3aed" Offset="0"/>
                  <GradientStop Color="#4f46e5" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="🎓" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="LectureSmith" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBg}" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="v4.0.0" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentSubtleText}"/>
                </Border>
              </Grid>
              <TextBlock Text="Study &amp; Notes Studio" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Navigation Menu -->
        <ScrollViewer Grid.Row="1" Padding="12,14" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,4"/>

            <Button Classes="navItem" Classes.active="{Binding IsWorkspaceActive}" Command="{Binding NavigateToWorkspaceCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Workspace" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Button Classes="navItem" Classes.active="{Binding IsHistoryActive}" Command="{Binding NavigateToHistoryCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="🕒" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="History" VerticalAlignment="Center"/>
              </Grid>
            </Button>

            <Button Classes="navItem" Classes.active="{Binding IsSettingsActive}" Command="{Binding NavigateToSettingsCommand}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status & Theme -->
        <StackPanel Grid.Row="2" Margin="12,10,12,16" Spacing="8">
          <Button Classes="secondary"
                  Command="{Binding NavigateToSettingsCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  Padding="12,9"
                  ToolTip.Tip="Open API Key Settings">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
              <Border Width="9" Height="9" CornerRadius="5"
                      Classes.valid="{Binding Settings.IsApiKeyValid}"
                      VerticalAlignment="Center">
                <Border.Styles>
                  <Style Selector="Border">
                    <Setter Property="Background" Value="#ef4444"/>
                  </Style>
                  <Style Selector="Border.valid">
                    <Setter Property="Background" Value="#10b981"/>
                  </Style>
                </Border.Styles>
              </Border>
              <TextBlock Grid.Column="1"
                         Text="{Binding Settings.ApiKeyStatus}"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"/>
            </Grid>
          </Button>

          <Button Classes="secondary"
                  Command="{Binding Settings.ToggleThemeCommand}"
                  Padding="12,9"
                  HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="🌙" FontSize="13.5" IsVisible="{Binding Settings.IsDarkMode}" VerticalAlignment="Center"/>
              <TextBlock Text="☀️" FontSize="13.5" IsVisible="{Binding !Settings.IsDarkMode}" VerticalAlignment="Center"/>
              <TextBlock Text="Dark Mode" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding Settings.IsDarkMode}" VerticalAlignment="Center"/>
              <TextBlock Text="Light Mode" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding !Settings.IsDarkMode}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ════════════════ MAIN CONTENT COLUMN ════════════════ -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <!-- Compact Header with Inline Telemetry Pills -->
      <Border Grid.Row="0"
              Background="{DynamicResource HeaderBackground}"
              BorderBrush="{DynamicResource CardBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="20,12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1" ClipToBounds="True">
            <StackPanel IsVisible="{Binding IsWorkspaceActive}" Spacing="1">
              <TextBlock Text="Workspace Overview" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Synthesize comprehensive, exam-ready lecture notes" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsHistoryActive}" Spacing="1">
              <TextBlock Text="Generation History" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Review past notes, open exports, and continue Q&amp;A" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel IsVisible="{Binding IsSettingsActive}" Spacing="1">
              <TextBlock Text="Settings &amp; Maintenance" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="Manage encrypted Gemini API credentials, theme, and caches" FontSize="11" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>

          <!-- Compact Telemetry Pills -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="statPill" Background="{DynamicResource StatWeeklyBg}" BorderBrush="{DynamicResource StatWeeklyBorder}">
              <StackPanel Spacing="1">
                <TextBlock Text="THIS WEEK" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatWeeklyLabel}"/>
                <TextBlock Text="{Binding WeeklyTokensDisplay, StringFormat='{}{0} tok'}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource StatWeeklyNumber}"/>
              </StackPanel>
            </Border>

            <Border Classes="statPill" Background="{DynamicResource StatMonthlyBg}" BorderBrush="{DynamicResource StatMonthlyBorder}">
              <StackPanel Spacing="1">
                <TextBlock Text="THIS MONTH" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatMonthlyLabel}"/>
                <TextBlock Text="{Binding MonthlyTokensDisplay, StringFormat='{}{0} tok'}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource StatMonthlyNumber}"/>
              </StackPanel>
            </Border>

            <Border Classes="statPill" Background="{DynamicResource StatModelBg}" BorderBrush="{DynamicResource StatModelBorder}" MaxWidth="220">
              <StackPanel Spacing="1">
                <TextBlock Text="ACTIVE MODEL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatModelLabel}"/>
                <TextBlock Text="{Binding Workspace.ActiveModelDisplay}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource StatModelNumber}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>

            <Border Classes="statPill" Background="{DynamicResource StatStatusBg}" BorderBrush="{DynamicResource StatStatusBorder}" MinWidth="135" MaxWidth="260">
              <StackPanel Spacing="1">
                <TextBlock Text="STUDIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StatStatusLabel}"/>
                <TextBlock Text="{Binding Workspace.ProgressMessage}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource StatStatusNumber}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Active Page Views -->
      <Grid Grid.Row="1">
        <views:WorkspaceView DataContext="{Binding Workspace}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsWorkspaceActive}"/>
        <views:HistoryView DataContext="{Binding History}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsHistoryActive}"/>
        <views:SettingsView DataContext="{Binding Settings}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSettingsActive}"/>
      </Grid>

    </Grid>

    <!-- ════════════════ MODAL OVERLAY: SKIP SLIDES ════════════════ -->
    <views:SkipSlidesModal Grid.ColumnSpan="2" DataContext="{Binding Workspace.SkipSlides}"/>

  </Grid>
</Window>
