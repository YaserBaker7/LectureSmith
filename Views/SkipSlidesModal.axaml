<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LectureSmith.ViewModels"
             x:Class="LectureSmith.Views.SkipSlidesModal"
             x:DataType="vm:SkipSlidesViewModel"
             IsVisible="{Binding IsOpen}">

  <Grid>
    <Button Background="{DynamicResource ModalBackdrop}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Command="{Binding CloseCommand}"
            Padding="0"
            BorderThickness="0"/>

    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource ModalBackground}"
            BorderBrush="{DynamicResource ModalBorder}"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="24"
            Width="880"
            MaxHeight="680">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="📋" FontSize="20"/>
            <TextBlock Text="Select Slides to Skip" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="small" Command="{Binding CloseCommand}" Content="✕" FontSize="16" Padding="8,4"/>
        </Grid>

        <!-- Subtext -->
        <TextBlock Grid.Row="1"
                   Text="Click on slides to mark them as skipped. Skipped slides are still used for lecture context, but appear only as 'Skipped' in generated notes."
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   LineHeight="18"/>

        <!-- Thumbnails Grid -->
        <ScrollViewer Grid.Row="2" MaxHeight="450" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Thumbnails}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SkippedSlideItemViewModel">
                <Border Classes="slideCard"
                        Classes.skipped="{Binding IsSkipped}"
                        Width="240"
                        Padding="8"
                        Margin="6"
                        PointerPressed="SlideCard_PointerPressed">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding SlideNumber, StringFormat='{}Slide {0}'}"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimary}"
                                 VerticalAlignment="Center"/>

                      <Border Grid.Column="1"
                              Background="{DynamicResource DangerBrush}"
                              CornerRadius="4"
                              Padding="6,2"
                              IsVisible="{Binding IsSkipped}">
                        <TextBlock Text="SKIPPED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                      </Border>
                      <Border Grid.Column="1"
                              Background="{DynamicResource AccentSubtleBg}"
                              BorderBrush="{DynamicResource AccentSubtleBorder}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="6,2"
                              IsVisible="{Binding !IsSkipped}">
                        <TextBlock Text="Include" FontSize="9" Foreground="{DynamicResource AccentSubtleText}"/>
                      </Border>
                    </Grid>

                    <Border Background="{DynamicResource CardBackgroundSecondary}" CornerRadius="6" ClipToBounds="True" Height="135">
                      <Grid>
                        <Image Source="{Binding SlideImage}" Stretch="Uniform"/>
                        <Border Background="{DynamicResource DangerSubtleBg}" Opacity="0.9" IsVisible="{Binding IsSkipped}">
                          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="✕" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="SKIPPED" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerSubtleText}" HorizontalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundSecondary}"
                CornerRadius="8"
                Padding="14,10"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SkippedSlidesDisplayText}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AccentSubtleText}"
                         IsVisible="{Binding SkippedSlidesDisplayText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <TextBlock Text="No slides skipped (all slides will be included)"
                         FontSize="12"
                         Foreground="{DynamicResource TextMuted}"
                         IsVisible="{Binding SkippedSlidesDisplayText, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding CloseCommand}" Content="Done" Padding="28,8"/>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</UserControl>
