<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LectureSmith.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- ════════════════ LIGHT THEME ════════════════ -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="HeaderBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="CardBorderBrushSubtle" Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="CardBorderHover" Color="#6366F1"/>

                    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="InputFocusBorder" Color="#4F46E5"/>
                    <SolidColorBrush x:Key="ControlHoverBackground" Color="#F1F5F9"/>

                    <SolidColorBrush x:Key="DropzoneBackground" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="DropzoneBorderBrush" Color="#94A3B8"/>
                    <SolidColorBrush x:Key="DropzoneHoverBackground" Color="#EEF2FF"/>
                    <SolidColorBrush x:Key="DropzoneHoverBorder" Color="#4F46E5"/>

                    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#334155"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
                    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA"/>
                    <SolidColorBrush x:Key="AccentSubtleBg" Color="#EEF2FF"/>
                    <SolidColorBrush x:Key="AccentSubtleBorder" Color="#C7D2FE"/>
                    <SolidColorBrush x:Key="AccentSubtleText" Color="#3730A3"/>

                    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
                    <SolidColorBrush x:Key="DangerSubtleBg" Color="#FEF2F2"/>
                    <SolidColorBrush x:Key="DangerSubtleBorder" Color="#FECACA"/>
                    <SolidColorBrush x:Key="DangerSubtleText" Color="#DC2626"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
                    <SolidColorBrush x:Key="SuccessSubtleBg" Color="#ECFDF5"/>
                    <SolidColorBrush x:Key="SuccessSubtleText" Color="#059669"/>

                    <SolidColorBrush x:Key="StatWeeklyBg" Color="#E0F2FE"/>
                    <SolidColorBrush x:Key="StatWeeklyBorder" Color="#7DD3FC"/>
                    <SolidColorBrush x:Key="StatWeeklyNumber" Color="#0369A1"/>
                    <SolidColorBrush x:Key="StatWeeklyLabel" Color="#075985"/>

                    <SolidColorBrush x:Key="StatMonthlyBg" Color="#DCFCE7"/>
                    <SolidColorBrush x:Key="StatMonthlyBorder" Color="#86EFAC"/>
                    <SolidColorBrush x:Key="StatMonthlyNumber" Color="#15803D"/>
                    <SolidColorBrush x:Key="StatMonthlyLabel" Color="#166534"/>

                    <SolidColorBrush x:Key="StatModelBg" Color="#EDE9FE"/>
                    <SolidColorBrush x:Key="StatModelBorder" Color="#C4B5FD"/>
                    <SolidColorBrush x:Key="StatModelNumber" Color="#6D28D9"/>
                    <SolidColorBrush x:Key="StatModelLabel" Color="#5B21B6"/>

                    <SolidColorBrush x:Key="StatStatusBg" Color="#F0FDF4"/>
                    <SolidColorBrush x:Key="StatStatusBorder" Color="#86EFAC"/>
                    <SolidColorBrush x:Key="StatStatusNumber" Color="#15803D"/>
                    <SolidColorBrush x:Key="StatStatusLabel" Color="#166534"/>

                    <SolidColorBrush x:Key="PreviewBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="PreviewBorder" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="PreviewText" Color="#0F172A"/>

                    <SolidColorBrush x:Key="ChatUserBubbleBg" Color="#4F46E5"/>
                    <SolidColorBrush x:Key="ChatUserBubbleFg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ChatAiBubbleBg" Color="#F1F5F9"/>
                    <SolidColorBrush x:Key="ChatAiBubbleBorder" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="ChatAiBubbleFg" Color="#0F172A"/>

                    <SolidColorBrush x:Key="ModalBackdrop" Color="#80000000"/>
                    <SolidColorBrush x:Key="ModalBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ModalBorder" Color="#CBD5E1"/>
                </ResourceDictionary>

                <!-- ════════════════ DARK THEME ════════════════ -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#090B12"/>
                    <SolidColorBrush x:Key="SidebarBackground" Color="#0E121E"/>
                    <SolidColorBrush x:Key="HeaderBackground" Color="#0E121E"/>
                    <SolidColorBrush x:Key="CardBackground" Color="#131827"/>
                    <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#181F32"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#232B45"/>
                    <SolidColorBrush x:Key="CardBorderBrushSubtle" Color="#1C2338"/>
                    <SolidColorBrush x:Key="CardBorderHover" Color="#6366F1"/>

                    <SolidColorBrush x:Key="InputBackground" Color="#141A2C"/>
                    <SolidColorBrush x:Key="InputBorderBrush" Color="#283350"/>
                    <SolidColorBrush x:Key="InputFocusBorder" Color="#8B5CF6"/>
                    <SolidColorBrush x:Key="ControlHoverBackground" Color="#1F2740"/>

                    <SolidColorBrush x:Key="DropzoneBackground" Color="#101524"/>
                    <SolidColorBrush x:Key="DropzoneBorderBrush" Color="#2E3A59"/>
                    <SolidColorBrush x:Key="DropzoneHoverBackground" Color="#1B193B"/>
                    <SolidColorBrush x:Key="DropzoneHoverBorder" Color="#8B5CF6"/>

                    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="TextMuted" Color="#8492A6"/>
                    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9"/>
                    <SolidColorBrush x:Key="AccentSubtleBg" Color="#1E1B4B"/>
                    <SolidColorBrush x:Key="AccentSubtleBorder" Color="#4338CA"/>
                    <SolidColorBrush x:Key="AccentSubtleText" Color="#C4B5FD"/>

                    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
                    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626"/>
                    <SolidColorBrush x:Key="DangerSubtleBg" Color="#2D1217"/>
                    <SolidColorBrush x:Key="DangerSubtleBorder" Color="#7F1D1D"/>
                    <SolidColorBrush x:Key="DangerSubtleText" Color="#FCA5A5"/>
                    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
                    <SolidColorBrush x:Key="SuccessSubtleBg" Color="#062E24"/>
                    <SolidColorBrush x:Key="SuccessSubtleText" Color="#34D399"/>

                    <SolidColorBrush x:Key="StatWeeklyBg" Color="#0A2B45"/>
                    <SolidColorBrush x:Key="StatWeeklyBorder" Color="#0E4A73"/>
                    <SolidColorBrush x:Key="StatWeeklyNumber" Color="#38BDF8"/>
                    <SolidColorBrush x:Key="StatWeeklyLabel" Color="#7DD3FC"/>

                    <SolidColorBrush x:Key="StatMonthlyBg" Color="#063F30"/>
                    <SolidColorBrush x:Key="StatMonthlyBorder" Color="#0B614A"/>
                    <SolidColorBrush x:Key="StatMonthlyNumber" Color="#34D399"/>
                    <SolidColorBrush x:Key="StatMonthlyLabel" Color="#6EE7B7"/>

                    <SolidColorBrush x:Key="StatModelBg" Color="#271257"/>
                    <SolidColorBrush x:Key="StatModelBorder" Color="#4C1D95"/>
                    <SolidColorBrush x:Key="StatModelNumber" Color="#C4B5FD"/>
                    <SolidColorBrush x:Key="StatModelLabel" Color="#A78BFA"/>

                    <SolidColorBrush x:Key="StatStatusBg" Color="#072D19"/>
                    <SolidColorBrush x:Key="StatStatusBorder" Color="#14532D"/>
                    <SolidColorBrush x:Key="StatStatusNumber" Color="#4ADE80"/>
                    <SolidColorBrush x:Key="StatStatusLabel" Color="#86EFAC"/>

                    <SolidColorBrush x:Key="PreviewBackground" Color="#0B0E17"/>
                    <SolidColorBrush x:Key="PreviewBorder" Color="#1E253A"/>
                    <SolidColorBrush x:Key="PreviewText" Color="#E2E8F0"/>

                    <SolidColorBrush x:Key="ChatUserBubbleBg" Color="#7C3AED"/>
                    <SolidColorBrush x:Key="ChatUserBubbleFg" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ChatAiBubbleBg" Color="#171D30"/>
                    <SolidColorBrush x:Key="ChatAiBubbleBorder" Color="#283354"/>
                    <SolidColorBrush x:Key="ChatAiBubbleFg" Color="#E2E8F0"/>

                    <SolidColorBrush x:Key="ModalBackdrop" Color="#B3000000"/>
                    <SolidColorBrush x:Key="ModalBackground" Color="#131827"/>
                    <SolidColorBrush x:Key="ModalBorder" Color="#4338CA"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextInverse}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.small:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style Selector="Button.navItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.navItem.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSubtleText}"/>
        </Style>

        <Style Selector="Button.tabBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.tabBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.tabBtn.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentSubtleText}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.statPill">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>

        <Style Selector="Border.dropzone">
            <Setter Property="BorderBrush" Value="{DynamicResource DropzoneBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource DropzoneBackground}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.dropzone:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource DropzoneHoverBorder}"/>
            <Setter Property="Background" Value="{DynamicResource DropzoneHoverBackground}"/>
        </Style>

        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="Border.fileChip">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <Style Selector="Border.slideCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.slideCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.slideCard.skipped">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DangerSubtleBg}"/>
        </Style>
    </Application.Styles>
</Application>
